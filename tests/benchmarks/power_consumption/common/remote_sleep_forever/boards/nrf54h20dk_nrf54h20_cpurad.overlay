/ {
	aliases {
		/*led = &led1;*/
		/delete-property/ led1;
	};

/*
	leds {
		compatible = "gpio-leds";
		led1: led_1 {
			gpios = <&gpio9 1 GPIO_ACTIVE_HIGH>;
			label = "Green LED 1";
		};
	};
*/
};

&gpio9 {
	status = "disabled";
};

&gpiote130 {
	status = "disabled";
};

&uart135 {
	status = "disabled";
	/delete-property/memory-regions;
};

// Attempts

&fll16m {
	status = "disabled";
};

